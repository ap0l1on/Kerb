{
  "name": "kerb",
  "private": true,
  "version": "1.0.0",
  "description": "A fast low-poly time-trial racer for the browser. Beat your ghost, chase the medals.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
