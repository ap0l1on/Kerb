    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "thumbs": "vite-node scripts/thumbs.ts",
    "ghosts": "vite-node scripts/authorGhosts.ts",
    "bench": "vite-node scripts/bench.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-node": "^3.1.0",
    "vitest": "^5.0.1"
  }
}
